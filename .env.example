DATABASE_URL=sqlite:///./data/vigilia.db
DATA_DIR=./data
DEMO_MODE=true
PERCEPTION_BACKEND=hog
YOLO_MODEL=yolo11n.pt
SAMPLE_FPS=2
# Minimum observed stationary seconds after a nearby person has moved away.
UNATTENDED_SECONDS=5
DETECTION_SIZE=640
DETECTION_CONFIDENCE=0.3
ENABLE_CLIP=false
ENABLE_OCR=false
# Set a long random token and DEMO_MODE=false before accessing non-demo footage.
API_TOKEN=
# Frontend server forwards API_TOKEN; it never exposes it to the browser.
BACKEND_URL=http://127.0.0.1:8100
MAX_UPLOAD_MB=250
# External MEVA data; shell expands ~ in exports. See docs/MEVA.md.
# MEVA_ROOT=~/VIGILIA_DATA
# MEVA_VIDEO_ROOT=~/VIGILIA_DATA/videos/meva
# MEVA_ANNOTATION_ROOT=~/VIGILIA_DATA/meva-data-repo/annotation/DIVA-phase-2/MEVA/kitware
